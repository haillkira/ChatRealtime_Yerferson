@page
@{
    ViewData["Title"] = "Chat de Yerferson";
}

<style>
    body {
        background: #eef4fa;
        color: #172b45;
    }

    .chat-shell {
        max-width: 960px;
        margin: 32px auto;
    }

    .chat-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dce5ef;
        border-radius: 22px;
        box-shadow: 0 16px 45px rgba(23, 43, 69, 0.08);
    }

    .chat-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        padding: 30px;
        background: #142d4e;
        color: #ffffff;
    }

    .chat-icon {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 64px;
        height: 64px;
        background: #204566;
        color: #69e0d0;
        border-radius: 18px;
    }

    .chat-header h1 {
        margin: 0 0 6px;
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 700;
    }

    .chat-header p {
        margin: 0;
        color: #d1deee;
        font-size: 0.95rem;
    }

    .chat-content {
        padding: 28px;
    }

    .chat-status {
        display: inline-block;
        margin-bottom: 24px;
        padding: 8px 14px;
        background: #edf3fa;
        color: #294a70;
        border: 1px solid #d7e3f1;
        border-radius: 30px;
        font-size: 0.9rem;
    }

    .chat-label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .chat-input-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .chat-input {
        flex: 1 1 220px;
        width: 100%;
        min-width: 0;
        padding: 12px 15px;
        background: #ffffff;
        color: #172b45;
        border: 1px solid #cbd7e5;
        border-radius: 12px;
        font: inherit;
    }

    .chat-input:focus {
        outline: 3px solid #c9eee9;
        border-color: #0f766e;
    }

    .chat-input:disabled {
        background: #f0f3f7;
        color: #63758a;
    }

    .chat-button {
        padding: 12px 20px;
        background: #1d4ed8;
        color: #ffffff;
        border: 0;
        border-radius: 12px;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
    }

    .chat-button:hover:not(:disabled) {
        background: #1e40af;
    }

    .chat-button:focus-visible {
        outline: 3px solid #93c5fd;
        outline-offset: 3px;
    }

    .chat-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .chat-button-send {
        background: #0f766e;
    }

    .chat-button-send:hover:not(:disabled) {
        background: #115e59;
    }

    .chat-user-form {
        margin-bottom: 18px;
    }

    #currentUser:empty,
    #errorMessage:empty {
        display: none;
    }

    #currentUser {
        margin: 0 0 22px;
        padding: 10px 14px;
        background: #f2f7fc;
        border-radius: 10px;
        overflow-wrap: anywhere;
    }

    #errorMessage {
        margin-top: 16px;
        color: #b91c1c;
        overflow-wrap: anywhere;
    }

    .chat-messages-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        margin: 28px 0 14px;
        padding-top: 24px;
        border-top: 1px solid #e3eaf2;
    }

    .chat-messages-header h2 {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 700;
    }

    .chat-messages-header span {
        color: #52647a;
        font-size: 0.85rem;
    }

    #messagesList {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: 420px;
        margin: 0;
        padding: 0;
        overflow-y: auto;
        list-style: none;
    }

    #messagesList:empty::before {
        content: "Entra al chat para consultar los mensajes y participar.";
        display: block;
        padding: 30px 18px;
        color: #52647a;
        text-align: center;
        background: #f8fafc;
        border: 1px dashed #cbd7e5;
        border-radius: 12px;
    }

    #messagesList .list-group-item {
        flex-shrink: 0;
        padding: 14px 16px;
        background: #f8fafc;
        color: #172b45;
        border: 1px solid #e0e8f1;
        border-radius: 12px;
        line-height: 1.6;
    }

    .chat-footer {
        padding: 16px 24px;
        background: #f8fafc;
        color: #52647a;
        border-top: 1px solid #e3eaf2;
        text-align: center;
        font-size: 0.85rem;
    }
</style>

<div class="chat-shell">
    <section class="chat-card" aria-labelledby="chatTitle">
        <header class="chat-header">
            <div class="chat-icon" aria-hidden="true">
                <svg width="38"
                     height="38"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.7"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H5l-4 3V11.5A7.5 7.5 0 0 1 8.5 4H12" />
                    <path d="M15 2h6a2 2 0 0 1 2 2v4l-3-2h-5a2 2 0 0 1-2-2 2 2 0 0 1 2-2Z" />
                    <circle cx="6" cy="12" r="0.5" />
                    <circle cx="10" cy="12" r="0.5" />
                    <circle cx="14" cy="12" r="0.5" />
                </svg>
            </div>

            <div>
                <h1 id="chatTitle">Chat de Yerferson</h1>
                <p>Yerferson Rosario Peña · Programacion IV</p>
            </div>
        </header>

        <div class="chat-content">
            <p id="connectionStatus"
               class="chat-status"
               role="status">
                Conectando...
            </p>

            <form id="userForm" class="chat-user-form">
                <label for="userInput" class="chat-label">
                    Tu nombre
                </label>

                <div class="chat-input-row">
                    <input id="userInput"
                           class="chat-input"
                           placeholder="Escribe tu alias"
                           maxlength="40"
                           autocomplete="nickname"
                           required />

                    <button id="joinButton"
                            type="submit"
                            class="chat-button"
                            disabled>
                        Entrar al chat
                    </button>
                </div>
            </form>

            <p id="currentUser"></p>

            <form id="chatForm">
                <label for="messageInput" class="chat-label">
                    Mensaje
                </label>

                <div class="chat-input-row">
                    <input id="messageInput"
                           class="chat-input"
                           placeholder="Escribe un mensaje..."
                           maxlength="1000"
                           autocomplete="off"
                           disabled
                           required />

                    <button id="sendButton"
                            type="submit"
                            class="chat-button chat-button-send"
                            disabled>
                        Enviar
                    </button>
                </div>
            </form>

            <p id="errorMessage" role="alert"></p>

            <div class="chat-messages-header">
                <h2>Conversacion</h2>
                <span>Mensajes en tiempo real</span>
            </div>

            <ul id="messagesList"
                aria-label="Mensajes del chat"
                aria-live="polite"
                aria-relevant="additions"></ul>
        </div>

        <footer class="chat-footer">
            Programacion IV · Matricula 100444062
        </footer>
    </section>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}